# Copy to .env and fill in. Everything here is bundled into the browser build,
# so only put values that are safe to be public. Auth0 client IDs are.

# Where the Express backend lives. No trailing slash.
VITE_BACKEND_URL=http://localhost:8080

# Auth0 application settings (Applications > your SPA > Settings).
# Domain is the tenant domain without the scheme, e.g. dev-abc.us.auth0.com.
VITE_AUTH0_DOMAIN=
VITE_AUTH0_CLIENT_ID=

# The API Identifier of the API you created in Auth0. Must match the backend's
# AUTH0_AUDIENCE exactly, or the access token will be rejected.
VITE_AUTH0_AUDIENCE=
