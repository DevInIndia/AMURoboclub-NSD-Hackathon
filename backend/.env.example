# Copy to .env and fill in. Never commit the filled-in file.

# Google AI Studio key for Gemini: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional: override the Gemini model used for answers and image descriptions.
# GEMINI_MODEL=gemini-3.5-flash

# Auth0 (Applications > APIs). AUTH0_DOMAIN is your tenant domain without the
# scheme, e.g. dev-abc123.eu.auth0.com. AUTH0_AUDIENCE is the API Identifier
# you gave the API in Auth0 -- it must match the frontend's audience exactly.
AUTH0_DOMAIN=
AUTH0_AUDIENCE=

# Postgres connection string. For the local Docker container started with the
# command in the README:
#   postgresql://celestial:celestial_dev@localhost:5433/celestial
# Hosted databases (Neon, Supabase, Render) give you a URL to paste here; TLS
# is enabled automatically for anything that is not localhost.
DATABASE_URL=

# Comma-separated frontend origins allowed to call this API.
# localhost:5173 is always allowed, so this is only needed for deployed sites.
ALLOWED_ORIGINS=

# Port to listen on.
PORT=8080
